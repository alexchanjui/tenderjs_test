# .env.docker

APP_VERSION=1.0.6
PORT=3001
NODE_ENV=development
DB_PASSWORD="YourStrong@Passw0rd"
DATABASE_URL="sqlserver://db:1433;database=tenderjs_db;user=sa;password=YourStrong@Passw0rd;encrypt=false;trustServerCertificate=true"
JWT_SECRET="please_change_this_to_a_very_long_random_secret_string"
JWT_EXPIRES_IN="1d"
LOG_STDOUT=true
LOG_LEVEL=debug
LOG_FILE=./data-log/node-service.log
LOG_ROTATION=true
LOG_MAX_SIZE=128
CORS_ORIGIN="http://localhost:4200"
ENABLE_SWAGGER=true
DEFAULT_ROLE=NormalUser
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0