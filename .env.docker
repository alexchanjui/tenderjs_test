# .env.example

# ==============================================
# Server Configuration (伺服器設定)
# ==============================================
PORT=3001
NODE_ENV=development

# ==============================================
# Database Configuration (Prisma - SQL Server)
# ==============================================
# SQL Server 連線字串格式：
# sqlserver://HOST:PORT;database=DB_NAME;user=USER;password=PWD;encrypt=BOOLEAN;trustServerCertificate=BOOLEAN
# 注意：
# 1. encrypt=false：本地開發通常設為 false
# 2. trustServerCertificate=true：略過本地自簽憑證檢查（Docker MSSQL 常用）
DB_PASSWORD="YourStrong@Passw0rd"
DATABASE_URL="sqlserver://db:1433;database=tenderjs_test;user=sa;password=YourStrong@Passw0rd;encrypt=false;trustServerCertificate=true"

# ==============================================
# Redis Configuration (快取設定)
# ==============================================
# Redis 連線格式：redis://:PASSWORD@HOST:PORT/DB
REDIS_URL=redis://redis:6379/0

# ==============================================
# JWT Authentication (認證設定)
# ==============================================
# Token 簽署密鑰（正式環境請更換為安全的隨機字串）
JWT_SECRET="please_change_this_to_a_very_long_random_secret_string"

# Token 過期時間
JWT_EXPIRES_IN="1d"

# ==============================================
# Logger Configuration (日誌設定)
# ==============================================
# 是否輸出到 Console
LOG_STDOUT=true

# 日誌等級（debug / info / warn / error）
LOG_LEVEL=debug

# 日誌檔案路徑
LOG_FILE=./data-log/node-service.log

# 是否啟用日誌輪替
LOG_ROTATION=true

# 單檔最大大小（MB 或 KB）
LOG_MAX_SIZE=128

# ==============================================
# Other Features (其他功能開關)
# ==============================================
# CORS 允許的來源（通常為前端網址）
CORS_ORIGIN="http://localhost:4200"

# 是否啟用 Swagger UI（正式環境建議設為 false）
ENABLE_SWAGGER=true

# 預設使用者角色（JWT 中無角色資訊時使用）
DEFAULT_ROLE=NormalUser