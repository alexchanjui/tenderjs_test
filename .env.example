# .env.example

# ==============================================
# Server Configuration (伺服器設定)
# ==============================================
PORT=3000
NODE_ENV=development

# ==============================================
# Database Configuration (Prisma - SQL Server)
# ==============================================
# SQL Server 連線字串格式：
# sqlserver://HOST:PORT;database=DB_NAME;user=USER;password=PWD;encrypt=BOOLEAN;trustServerCertificate=BOOLEAN
# 注意：
# 1. encrypt=false: 通常本地開發時設為 false
# 2. trustServerCertificate=true: 用於略過本地自簽憑證檢查 (Docker MSSQL 常見)
DATABASE_URL="sqlserver://localhost:1433;database=tenderjs_db;user=sa;password=yourStrong(!)Password;encrypt=false;trustServerCertificate=true"

# ==============================================
# Redis Configuration (快取設定)
# ==============================================
# Redis 連線設定 redis://:密碼@主機:Port/DB
REDIS_URL=redis://127.0.0.1:6380/0

# ==============================================
# JWT Authentication (認證設定)
# ==============================================
# 用於簽署 Token 的密鑰 (請務必在正式環境修改為長亂碼)
JWT_SECRET="please_change_this_to_a_very_long_random_secret_string"

# Token 過期時間
JWT_EXPIRES_IN="1d"

# ==============================================
# Logger Configuration (日誌設定)
# ==============================================
# 是否輸出到 Console
LOG_STDOUT=true
# 日誌等級 (debug, info, warn, error)
LOG_LEVEL=debug
# 日誌檔案路徑
LOG_FILE=./data-log/node-service.log
# 是否啟用日誌輪替
LOG_ROTATION=true
# 單檔最大大小 (MB 或 KB)
LOG_MAX_SIZE=128

# ==============================================
# Other Features (其他功能開關)
# ==============================================
# CORS 允許的來源 (通常前端網址)
CORS_ORIGIN="http://localhost:4200"

# 控制 Swagger 是否載入 (建議：正式環境設為 false)
ENABLE_SWAGGER=true

# 預設使用者角色 (當 JWT 中無角色資訊時使用)
DEFAULT_ROLE=NormalUser