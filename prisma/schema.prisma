/// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

// ==========================================
// 核心系統
// ==========================================

/// 系統使用者
/// 用途：管理使用者帳號與登入資訊
model User {
  /// 使用者 ID
  id String @id @default(dbgenerated("newid()")) @db.UniqueIdentifier

  /// 登入帳號
  account String @unique

   /// 使用者名稱
  username String

  /// 使用者 Email
  email String @unique

  /// 使用者密碼（Bcrypt Hash）
  password String

  /// 啟用狀態
  isActive Boolean @default(true) @map("is_active")

  /// 所屬業者 ID
  /// null 代表營運使用者
  vendorId String? @map("vendor_id") @db.UniqueIdentifier

  /// 所屬業者
  vendor Vendor? @relation(fields: [vendorId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  /// 所屬角色 ID
  roleId String? @map("role_id") @db.UniqueIdentifier

  /// 所屬角色
  role Role? @relation(fields: [roleId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  /// 使用者的 API 稽核日誌
  auditLogs AuditLog[]

  /// 建立時間
  createdAt DateTime @default(now()) @map("create_time")

  /// 更新時間
  updatedAt DateTime @updatedAt @map("update_time")

  @@index([vendorId])
  @@map("user")
}

/// 系統角色
/// 用途：管理角色
model Role {
  /// 角色 ID
  id String @id @default(dbgenerated("newid()")) @db.UniqueIdentifier

  /// 角色名稱
  name String

  /// 角色說明
  description String?

  /// 啟用狀態
  isActive Boolean @default(true) @map("is_active")

  /// 是否為業者預設管理員角色
  isVendorAdmin Boolean @default(false) @map("is_vendor_admin")

  /// 所屬業者 ID
  /// null 代表營運角色
  vendorId String? @map("vendor_id") @db.UniqueIdentifier

  /// 所屬業者
  vendor Vendor? @relation(fields: [vendorId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  /// 建立時間
  createdAt DateTime @default(now()) @map("create_time")

  /// 更新時間
  updatedAt DateTime @updatedAt @map("update_time")

  /// 使用此角色的使用者
  users User[]

  /// 角色擁有的頁面權限
  rolePages RolePage[]

  @@index([vendorId])
  @@map("role")
}

/// 頁面
/// 用途：管理頁面
model Page {
  /// 固定頁面 ID
  id Int @id @default(autoincrement())

  /// 可修改的唯一頁面代碼
  pageCode Int @unique @map("page_code")

  /// 頁面名稱
  name String

  /// 頁面描述
  description String?

  /// 頁面路徑
  routePath String? @map("route_path")

  /// 啟用狀態
  isActive Boolean @default(true) @map("is_active")

  /// 建立時間
  createdAt DateTime @default(now()) @map("create_time")

  /// 更新時間
  updatedAt DateTime @updatedAt @map("update_time")

  /// 使用此頁面的業者
  vendorPages VendorPage[]

  /// 使用此頁面的角色
  rolePages RolePage[]

  permissions Permission[]

  @@map("page")
}

/// 系統權限
/// 用途：管理 API 存取權限
model Permission {
  /// 權限 ID
  id Int @id @default(autoincrement())

  /// 頁面 ID
  /// null 代表不屬於頁面的系統 API
  pageId Int?  @map("page_id")
  page   Page? @relation(fields: [pageId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  /// 權限名稱
  name String @unique

  /// API 路徑 (例如: "/api/users")
  apiPath String @map("api_path")

  /// API 操作類型 （0: GET, 1: POST, 2: PUT, 3: DELETE）
  actionType Int @map("action_type")

  /// 啟用狀態
  isActive Boolean @default(true) @map("is_active")

  /// 是否需要登入及權限驗證
  isRequired Boolean @default(true) @map("is_required")

  /// 權限說明
  description String?

  /// 建立時間
  createdAt DateTime @default(now()) @map("create_time")

  /// 更新時間
  updatedAt DateTime @updatedAt @map("update_time")

  /// 同一個 API 路徑與操作類型不可重複
  @@unique([apiPath, actionType])
  /// 建立頁面 ID 索引查詢
  @@index([pageId])
  @@map("permission")
}

/// 業者
/// 用途：管理業者
model Vendor {
  /// 業者 ID
  id String @id @default(dbgenerated("newid()")) @db.UniqueIdentifier

  /// 業者代碼
  code String @unique

  /// 業者名稱
  name String

  /// 業者說明
  description String?

  /// 啟用狀態
  isActive Boolean @default(true) @map("is_active")

  /// 業者使用者
  users User[]

  /// 業者角色
  roles Role[]

  /// 業者可使用的頁面
  vendorPages VendorPage[]

  /// 建立時間
  createdAt DateTime @default(now()) @map("create_time")

  /// 更新時間
  updatedAt DateTime @updatedAt @map("update_time")

  @@map("vendor")
}

// ==========================================
// 關聯資料
// ==========================================

/// 角色頁面權限
/// 用途：管理角色實際使用頁面
model RolePage {
  /// 角色 ID
  roleId String @map("role_id") @db.UniqueIdentifier

  /// 頁面 ID
  pageId Int @map("page_id")

  /// 角色
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  /// 頁面
  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  /// 同一角色與頁面只能有一筆設定
  @@id([roleId, pageId])
  @@map("role_page")
}

/// 業者頁面權限
/// 用途：管理業者最大可使用頁面
model VendorPage {
  /// 業者 ID
  vendorId String @map("vendor_id") @db.UniqueIdentifier

  /// 頁面 ID
  pageId Int @map("page_id")

  /// 業者
  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  /// 頁面
  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  /// 同一業者與頁面只能有一筆設定
  @@id([vendorId, pageId])
  @@map("vendor_page")
}

// ==========================================
// 系統日誌
// 用途: API 稽核日誌
// ==========================================

model AuditLog {
  /// 稽核日誌 ID
  id BigInt @id @default(autoincrement())

  /// 操作使用者 ID
  /// 未登入的 API 可為 null
  userId String? @map("user_id") @db.UniqueIdentifier

  /// API 操作
  /// 例如：GET /api/roles
  action String @db.VarChar(200)

  /// Request IP
  ipAddress String? @map("ip_address") @db.VarChar(45)

  /// User Agent
  userAgent String? @map("user_agent") @db.NVarChar(Max)

  /// HTTP Status Code
  statusCode Int @map("status_code")

  /// 系統 Business Code
  bizCode Int @default(0) @map("biz_code")

  /// Request 資料
  reqData String? @map("req_data") @db.NVarChar(Max)

  /// Response 資料
  resData String? @map("res_data") @db.NVarChar(Max)

  /// API 執行時間（毫秒）
  duration Int @default(0)

  /// API 是否執行成功
  isSuccess Boolean @default(true) @map("is_success")

  /// 建立時間
  createdAt DateTime @default(now()) @map("create_time")

  /// 操作使用者
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
  @@index([statusCode])
  @@map("audit_log")
}
