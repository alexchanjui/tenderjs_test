/// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

// ==========================================
// 核心系統
// ==========================================

/// 系統使用者
/// 用途：管理使用者帳號與登入資訊
model User {
  /// 使用者 ID
  id String @id @default(dbgenerated("newid()")) @db.UniqueIdentifier

  /// 登入帳號
  account String @unique

  /// 使用者名稱
  username String

  /// 使用者 Email
  email String @unique

  /// 使用者密碼（Bcrypt Hash）
  password String

  /// 啟用狀態
  isActive Boolean @default(true) @map("is_active")

  /// 所屬節點 ID
  nodeId String @map("node_id") @db.UniqueIdentifier

  /// 所屬節點
  node Node @relation(fields: [nodeId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  /// 所屬角色 ID
  roleId String? @map("role_id") @db.UniqueIdentifier

  /// 所屬角色
  role Role? @relation(fields: [roleId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  /// 使用者的 API 稽核日誌
  auditLogs AuditLog[]

  /// 建立時間
  createdAt DateTime @default(now()) @map("create_time")

  /// 更新時間
  updatedAt DateTime @updatedAt @map("update_time")

  @@index([nodeId])
  @@map("user")
}

/// 系統角色
/// 用途：管理角色
model Role {
  /// 角色 ID
  id String @id @default(dbgenerated("newid()")) @db.UniqueIdentifier

  /// 角色名稱
  name String

  /// 角色說明
  description String?

  /// 啟用狀態
  isActive Boolean @default(true) @map("is_active")

  /// 是否為業者預設管理員角色
  isVendorAdmin Boolean @default(false) @map("is_vendor_admin")

  /// 所屬節點 ID
  nodeId String @map("node_id") @db.UniqueIdentifier

  /// 所屬節點
  node Node @relation(fields: [nodeId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  /// 建立時間
  createdAt DateTime @default(now()) @map("create_time")

  /// 更新時間
  updatedAt DateTime @updatedAt @map("update_time")

  /// 使用此角色的使用者
  users User[]

  /// 角色擁有的頁面權限
  rolePages RolePage[]

  @@index([nodeId])
  @@map("role")
}

/// 頁面
/// 用途：管理頁面
model Page {
  /// 固定頁面 ID
  id Int @id @default(autoincrement())

  /// 可修改的唯一頁面代碼
  pageCode Int @unique @map("page_code")

  /// 頁面名稱
  name String

  /// 頁面描述
  description String?

  /// 頁面路徑
  routePath String? @map("route_path")

  /// 啟用狀態
  isActive Boolean @default(true) @map("is_active")

  /// 建立時間
  createdAt DateTime @default(now()) @map("create_time")

  /// 更新時間
  updatedAt DateTime @updatedAt @map("update_time")

  /// 使用此頁面的節點
  nodePages NodePage[]

  /// 使用此頁面的角色
  rolePages RolePage[]

  /// 頁面所屬 API 權限
  permissions Permission[]

  @@map("page")
}

/// 系統權限
/// 用途：管理 API 存取權限
model Permission {
  /// 權限 ID
  id Int @id @default(autoincrement())

  /// 頁面 ID
  /// null 代表不屬於頁面的系統 API
  pageId Int? @map("page_id")

  /// 所屬頁面
  page Page? @relation(fields: [pageId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  /// 權限名稱
  name String @unique

  /// API 路徑 (例如: "/api/users")
  apiPath String @map("api_path")

  /// API 操作類型 （0: GET, 1: POST, 2: PUT, 3: DELETE）
  actionType Int @map("action_type")

  /// 啟用狀態
  isActive Boolean @default(true) @map("is_active")

  /// 是否需要登入及權限驗證
  isRequired Boolean @default(true) @map("is_required")

  /// 權限說明
  description String?

  /// 建立時間
  createdAt DateTime @default(now()) @map("create_time")

  /// 更新時間
  updatedAt DateTime @updatedAt @map("update_time")

  /// 同一個 API 路徑與操作類型不可重複
  @@unique([apiPath, actionType])
  /// 建立頁面 ID 索引查詢
  @@index([pageId])
  @@map("permission")
}

/// 組織節點
/// 用途：管理營運與業者
model Node {
  /// 節點 ID
  id String @id @default(dbgenerated("newid()")) @db.UniqueIdentifier

  /// 節點代碼
  code String @unique

  /// 節點名稱
  name String

  /// 節點類型
  /// OPERATOR: 營運
  /// VENDOR: 業者
  type String

  /// 節點說明
  description String?

  /// 啟用狀態
  isActive Boolean @default(true) @map("is_active")

  /// 節點使用者
  users User[]

  /// 節點角色
  roles Role[]

  /// 節點可使用的頁面
  nodePages NodePage[]

   /// 業者詳細資訊
  vendorProfile VendorProfile?

  /// 建立時間
  createdAt DateTime @default(now()) @map("create_time")

  /// 更新時間
  updatedAt DateTime @updatedAt @map("update_time")

  @@index([type])
  @@map("node")
}

// ==========================================
// 關聯資料
// ==========================================

/// 角色頁面權限
/// 用途：管理角色實際使用頁面
model RolePage {
  /// 角色 ID
  roleId String @map("role_id") @db.UniqueIdentifier

  /// 頁面 ID
  pageId Int @map("page_id")

  /// 角色
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  /// 頁面
  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  /// 同一角色與頁面只能有一筆設定
  @@id([roleId, pageId])
  @@map("role_page")
}

/// 節點頁面權限
/// 用途：管理節點最大可使用頁面
model NodePage {
  /// 節點 ID
  nodeId String @map("node_id") @db.UniqueIdentifier

  /// 頁面 ID
  pageId Int @map("page_id")

  /// 節點
  node Node @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  /// 頁面
  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  /// 同一節點與頁面只能有一筆設定
  @@id([nodeId, pageId])
  @@map("node_page")
}

// ==========================================
// 系統日誌
// ==========================================

model AuditLog {
  /// 稽核日誌 ID
  id BigInt @id @default(autoincrement())

  /// 操作使用者 ID
  /// 未登入的 API 可為 null
  userId String? @map("user_id") @db.UniqueIdentifier

  /// API 操作
  /// 例如：GET /api/roles
  action String @db.VarChar(200)

  /// Request IP
  ipAddress String? @map("ip_address") @db.VarChar(45)

  /// User Agent
  userAgent String? @map("user_agent") @db.NVarChar(Max)

  /// HTTP Status Code
  statusCode Int @map("status_code")

  /// 系統 Business Code
  bizCode Int @default(0) @map("biz_code")

  /// Request 資料
  reqData String? @map("req_data") @db.NVarChar(Max)

  /// Response 資料
  resData String? @map("res_data") @db.NVarChar(Max)

  /// API 執行時間（毫秒）
  duration Int @default(0)

  /// API 是否執行成功
  isSuccess Boolean @default(true) @map("is_success")

  /// 建立時間
  createdAt DateTime @default(now()) @map("create_time")

  /// 操作使用者
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
  @@index([statusCode])
  @@map("audit_log")
}


// ==========================================
// 業者詳細資訊
// ==========================================
model VendorProfile {
  id String @id @default(dbgenerated("newid()")) @db.UniqueIdentifier

  /// 所屬節點 ID
  nodeId String @unique @map("node_id") @db.UniqueIdentifier

  /// 品牌名稱
  brandName String @map("brand_name")

  /// 品牌介紹
  description String?

  /// 品牌圖片
  brandImage String? @map("brand_image")

  /// 聯絡電話
  phone String?

  /// 聯絡信箱
  email String?

  /// 地址
  address String?

  /// 所屬節點
  node Node @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  /// 主視覺橫幅
  banners VendorBanner[]

  /// 問答分類
  faqCategories FaqCategory[]

  /// 營運條款
  operatingTerms OperatingTerm[]

  /// 建立時間
  createdAt DateTime @default(now()) @map("create_time")

  /// 更新時間
  updatedAt DateTime @updatedAt @map("update_time")

  @@map("vendor_profile")
}

/// 業者主視覺橫幅
model VendorBanner {
  id Int @id @default(autoincrement())

  /// 業者詳細資訊 ID
  vendorProfileId String @map("vendor_profile_id") @db.UniqueIdentifier

  /// 圖片路徑
  imageUrl String @map("image_url")

  /// 排序
  sortOrder Int @default(1) @map("sort_order")

  /// 業者詳細資訊
  vendorProfile VendorProfile @relation( fields: [vendorProfileId], references: [id], onDelete: Cascade)

  @@index([vendorProfileId])
  @@map("vendor_banner")
}

/// 問答分類
model FaqCategory {
  id Int @id @default(autoincrement())

  /// 業者詳細資訊 ID
  vendorProfileId String @map("vendor_profile_id") @db.UniqueIdentifier

  /// 分類標題
  title String

  /// 排序
  sortOrder Int @default(1) @map("sort_order")

  /// 啟用狀態
  isActive Boolean @default(true) @map("is_active")

  /// 所屬業者
  vendorProfile VendorProfile @relation( fields: [vendorProfileId], references: [id], onDelete: Cascade)

  /// 問答列表
  faqs Faq[]

  @@index([vendorProfileId])
  @@map("faq_category")
}

/// 問答
model Faq {
  id Int @id @default(autoincrement())

  /// 問答分類 ID
  categoryId Int @map("category_id")

  /// 標題
  title String

  /// 內容
  content String

  /// 排序
  sortOrder Int @default(1) @map("sort_order")

  /// 啟用狀態
  isActive Boolean @default(true) @map("is_active")

  /// 所屬分類
  category FaqCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId])
  @@map("faq")
}

/// 營運條款
model OperatingTerm {
  id Int @id @default(autoincrement())

  /// 業者詳細資訊 ID
  vendorProfileId String @map("vendor_profile_id") @db.UniqueIdentifier

  /// 標題
  title String

  /// 內容
  content String

  /// 排序
  sortOrder Int @default(1) @map("sort_order")

  /// 啟用狀態
  isActive Boolean @default(true) @map("is_active")

  /// 所屬業者
  vendorProfile VendorProfile @relation(fields: [vendorProfileId], references: [id], onDelete: Cascade)

  @@index([vendorProfileId])
  @@map("operating_term")
}