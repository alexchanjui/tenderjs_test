/// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

// ==========================================
// 核心系統模組 (Core System Models)
// ==========================================

/// 系統使用者
/// 負責儲存使用者登入資訊、帳號狀態與基本資料
model User {
  /// 使用者 ID
  id String @id @default(dbgenerated("newid()")) @db.UniqueIdentifier

  /// 使用者名稱
  username String @unique

  /// 使用者 Email
  email String @unique

  /// 使用者密碼（Bcrypt Hash）
  password String

  /// 帳號是否啟用
  isActive Boolean @default(true) @map("is_active")

  /// 所屬角色 ID
  roleId String? @map("role_id") @db.UniqueIdentifier

  /// 所屬角色
  role Role? @relation(fields: [roleId], references: [id])

  /// 使用者的 API 稽核日誌
  auditLogs AuditLog[]

  /// 建立時間
  createdAt DateTime @default(now()) @map("create_time")

  /// 更新時間
  updatedAt DateTime @updatedAt @map("update_time")

  /// 測試
 remark String?

  @@map("user")
}

/// 系統角色
/// 負責定義使用者角色，例如 ADMIN、USER
model Role {
  /// 角色 ID
  id String @id @default(dbgenerated("newid()")) @db.UniqueIdentifier

  /// 角色名稱
  name String @unique

  /// 角色說明
  description String?

  /// 角色是否啟用
  isActive Boolean @default(true) @map("is_active")

  /// 建立時間
  createdAt DateTime @default(now()) @map("create_time")

  /// 更新時間
  updatedAt DateTime @updatedAt @map("update_time")

  /// 使用此角色的使用者
  users User[]

  /// 角色擁有的權限
  rolePermissions RolePermission[]

  @@map("role")
}

/// 系統權限
/// 定義後端 API 可執行的操作權限
model Permission {
  /// 權限 ID
  id Int @id

  /// 功能代碼
  featureCode Int @map("feature_code")

  /// 權限名稱
  name String @unique

  /// API 路徑 (例如: "/api/users")
  apiPath String @map("api_path")

  /// API 操作類型 （0: GET, 1: POST, 2: PUT, 3: DELETE）
  actionType Int @map("action_type")

  /// 權限是否啟用
  isActive Boolean @default(true) @map("is_active")

  /// 是否需要登入及權限驗證
  isRequired Boolean @default(true) @map("is_required")

  /// 權限說明
  description String?

  /// 建立時間
  createdAt DateTime @default(now()) @map("create_time")

  /// 更新時間
  updatedAt DateTime @updatedAt @map("update_time")

  /// 使用此權限的角色
  rolePermissions RolePermission[]

  /// 同一個 API 路徑與操作類型不可重複
  @@unique([apiPath, actionType])
  /// 建立功能代碼索引查詢
  @@index([featureCode])
  @@map("permission")
}

// ==========================================
// 關聯中間表 (Join Tables)
// ==========================================

/// 角色與權限關聯
model RolePermission {
  /// 角色 ID
  roleId String @map("role_id") @db.UniqueIdentifier

  /// 權限 ID
  permissionId Int @map("permission_id")

  /// 角色
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  /// 權限
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  /// roleId + permissionId 作為複合主鍵
  @@id([roleId, permissionId])
  
  @@map("role_permission")
}


// ==========================================
// 系統日誌模組 (System Log Models)
// ==========================================

/// API 稽核日誌
/// 記錄使用者 API 操作、Request、Response 與執行結果
model AuditLog {
  /// 稽核日誌 ID
  id BigInt @id @default(autoincrement())

  /// 操作使用者 ID
  /// 未登入的 API 可為 null
  userId String? @map("user_id") @db.UniqueIdentifier

  /// API 操作
  /// 例如：GET /api/roles
  action String @db.VarChar(200)

  /// Request IP
  ipAddress String? @map("ip_address") @db.VarChar(45)

  /// User Agent
  userAgent String? @map("user_agent") @db.NVarChar(Max)

  /// HTTP Status Code
  statusCode Int @map("status_code")

  /// 系統 Business Code
  bizCode Int @default(0) @map("biz_code")

  /// Request 資料
  reqData String? @map("req_data") @db.NVarChar(Max)

  /// Response 資料
  resData String? @map("res_data") @db.NVarChar(Max)

  /// API 執行時間（毫秒）
  duration Int @default(0)

  /// API 是否執行成功
  isSuccess Boolean @default(true) @map("is_success")

  /// 建立時間
  createdAt DateTime @default(now()) @map("create_time")

  /// 操作使用者
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
  @@index([statusCode])

  @@map("audit_log")
}