/// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

// ==========================================
// 核心系統
// ==========================================

/// 業者
/// 用途：管理業者
model Vendor {
  /// 業者 ID
  id String @id @default(dbgenerated("newid()")) @db.UniqueIdentifier

  /// 業者名稱
  name String

  /// 業者代碼
  code String @unique

  /// 啟用狀態
  isActive Boolean @default(true) @map("is_active")

  /// 業者使用者
  users User[]

  /// 業者角色
  roles Role[]

  /// 業者可使用的權限
  vendorPermissions VendorPermission[]

  /// 建立時間
  createdAt DateTime @default(now()) @map("create_time")

  /// 更新時間
  updatedAt DateTime @updatedAt @map("update_time")

  @@map("vendor")
}

/// 系統使用者
/// 用途：管理營運方與業者使用者資訊
model User {
  /// 使用者 ID
  id String @id @default(dbgenerated("newid()")) @db.UniqueIdentifier

  /// 使用者帳號
  /// 全平台唯一
  username String @unique

  /// 使用者暱稱
  nickname String

  /// 使用者 Email
  /// 全平台唯一
  email String @unique

  /// 使用者密碼（Bcrypt Hash）
  password String

  /// 使用者類型
  /// PLATFORM：營運方
  /// VENDOR：業者
  userType String @map("user_type")

  /// 所屬業者 ID
  /// PLATFORM：null
  /// VENDOR：所屬業者 ID
  vendorId String? @map("vendor_id") @db.UniqueIdentifier

  /// 所屬業者
  vendor Vendor? @relation(fields: [vendorId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  /// 所屬角色 ID
  /// 一個使用者對應一個角色
  roleId String? @map("role_id") @db.UniqueIdentifier

  /// 所屬角色
  role Role? @relation(fields: [roleId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  /// 啟用狀態
  isActive Boolean @default(true) @map("is_active")

  /// 使用者 API 稽核日誌
  auditLogs AuditLog[]

  /// 建立時間
  createdAt DateTime @default(now()) @map("create_time")

  /// 更新時間
  updatedAt DateTime @updatedAt @map("update_time")

  @@index([vendorId])
  @@index([roleId])
  @@map("user")
}

/// 系統角色
/// 用途：管理營運方與業者角色
model Role {
  /// 角色 ID
  id String @id @default(dbgenerated("newid()")) @db.UniqueIdentifier

  /// 角色名稱
  name String

  /// 角色說明
  description String?

  /// 角色範圍
  /// PLATFORM：營運方角色
  /// VENDOR：業者角色
  scope String

  /// 所屬業者 ID
  /// PLATFORM：null
  /// VENDOR：所屬業者 ID
  vendorId String? @map("vendor_id") @db.UniqueIdentifier

  /// 所屬業者
  vendor Vendor? @relation(fields: [vendorId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  /// 是否為系統角色
  /// 例如：VENDOR_ADMIN
  isSystem Boolean @default(false) @map("is_system")

  /// 啟用狀態
  isActive Boolean @default(true) @map("is_active")

  /// 使用此角色的使用者
  users User[]

  /// 頁面權限
  rolePages RolePage[]

  /// API 權限
  rolePermissions RolePermission[]

  /// 建立時間
  createdAt DateTime @default(now()) @map("create_time")

  /// 更新時間
  updatedAt DateTime @updatedAt @map("update_time")

  @@index([vendorId, name])
  @@index([scope])
  @@map("role")
}

/// 頁面
/// 用途：管理系統頁面
model Page {
  /// 頁面 ID
  id Int @id @default(autoincrement())

  /// 頁面代碼
  pageCode Int @unique @map("page_code")

  /// 頁面名稱
  name String

  /// 頁面描述
  description String?

  /// 頁面路徑
  routePath String? @map("route_path")

  /// 啟用狀態
  isActive Boolean @default(true) @map("is_active")

  /// 角色頁面權限
  rolePages RolePage[]

  /// 頁面 API 權限
  permissions Permission[]

  /// 建立時間
  createdAt DateTime @default(now()) @map("create_time")

  /// 更新時間
  updatedAt DateTime @updatedAt @map("update_time")

  @@map("page")
}

/// 系統權限
/// 用途：管理 API 存取權限
model Permission {
  /// 權限 ID
  id Int @id @default(autoincrement())

  /// 所屬頁面 ID
  /// null 代表不屬於特定頁面的系統 API
  pageId Int? @map("page_id")

  /// 所屬頁面
  page Page? @relation(fields: [pageId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  /// 權限名稱
  name String @unique

  /// API 路徑
  /// 例如：/api/users
  apiPath String @map("api_path")

  /// API 操作類型
  /// 0：GET
  /// 1：POST
  /// 2：PUT
  /// 3：DELETE
  actionType Int @map("action_type")

  /// 啟用狀態
  isActive Boolean @default(true) @map("is_active")

  /// 是否需要登入及權限驗證
  isRequired Boolean @default(true) @map("is_required")

  /// 權限說明
  description String?

  /// 角色權限
  rolePermissions RolePermission[]

  /// 業者權限
  vendorPermissions VendorPermission[]

  /// 建立時間
  createdAt DateTime @default(now()) @map("create_time")

  /// 更新時間
  updatedAt DateTime @updatedAt @map("update_time")

  /// 同一 API + HTTP Method 不可重複
  @@unique([apiPath, actionType])
  @@index([pageId])
  @@map("permission")
}

// ==========================================
// 權限關聯
// ==========================================

/// 業者權限
/// 用途：定義業者最多可以使用哪些權限
model VendorPermission {
  /// 業者 ID
  vendorId String @map("vendor_id") @db.UniqueIdentifier

  /// 權限 ID
  permissionId Int @map("permission_id")

  /// 業者
  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  /// 權限
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([vendorId, permissionId])
  @@index([permissionId])
  @@map("vendor_permission")
}

/// 角色 API 權限
/// 用途：定義角色可以使用哪些 API
model RolePermission {
  /// 角色 ID
  roleId String @map("role_id") @db.UniqueIdentifier

  /// 權限 ID
  permissionId Int @map("permission_id")

  /// 角色
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  /// 權限
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permission")
}

/// 角色頁面權限
/// 用途：管理角色可以存取哪些頁面
model RolePage {
  /// 角色 ID
  roleId String @map("role_id") @db.UniqueIdentifier

  /// 頁面 ID
  pageId Int @map("page_id")

  /// 角色
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  /// 頁面
  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@id([roleId, pageId])
  @@map("role_page")
}

// ==========================================
// 系統日誌
// ==========================================

/// API 稽核日誌
model AuditLog {
  /// 稽核日誌 ID
  id BigInt @id @default(autoincrement())

  /// 操作使用者 ID
  /// 未登入 API 可為 null
  userId String? @map("user_id") @db.UniqueIdentifier

  /// API 操作
  /// 例如：GET /api/roles
  action String @db.VarChar(200)

  /// Request IP
  ipAddress String? @map("ip_address") @db.VarChar(45)

  /// User Agent
  userAgent String? @map("user_agent") @db.NVarChar(Max)

  /// HTTP Status Code
  statusCode Int @map("status_code")

  /// 系統 Business Code
  bizCode Int @default(0) @map("biz_code")

  /// Request 資料
  reqData String? @map("req_data") @db.NVarChar(Max)

  /// Response 資料
  resData String? @map("res_data") @db.NVarChar(Max)

  /// API 執行時間（毫秒）
  duration Int @default(0)

  /// API 是否執行成功
  isSuccess Boolean @default(true) @map("is_success")

  /// 建立時間
  createdAt DateTime @default(now()) @map("create_time")

  /// 操作使用者
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
  @@index([statusCode])
  @@map("audit_log")
}
