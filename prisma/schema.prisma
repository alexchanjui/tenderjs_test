/// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

// ==========================================
// 核心系統模組 (Core System Models)
// ==========================================

/// 系統使用者
/// 負責儲存使用者登入資訊、帳號狀態與基本資料
model User {
  /// 使用者 ID
  id String @id @default(dbgenerated("newid()")) @db.UniqueIdentifier

  /// 使用者名稱
  username String @unique

  /// 使用者 Email
  email String @unique

  /// 使用者密碼（Bcrypt Hash）
  password String

  /// 帳號是否啟用
  isActive Boolean @default(true) @map("is_active")

  /// 所屬角色 ID
  roleId String? @map("role_id") @db.UniqueIdentifier

  /// 所屬角色
  role Role? @relation(fields: [roleId], references: [id])

  /// 建立時間
  createdAt DateTime @default(now()) @map("create_time")

  /// 更新時間
  updatedAt DateTime @updatedAt @map("update_time")

  @@map("user")
}

/// 系統角色
/// 負責定義使用者角色，例如 ADMIN、USER
model Role {
  /// 角色 ID
  id String @id @default(dbgenerated("newid()")) @db.UniqueIdentifier

  /// 角色名稱
  name String @unique

  /// 角色說明
  description String?

  /// 角色是否啟用
  isActive Boolean @default(true) @map("is_active")

  /// 建立時間
  createdAt DateTime @default(now()) @map("create_time")

  /// 更新時間
  updatedAt DateTime @updatedAt @map("update_time")

  /// 使用此角色的使用者
  users User[]

  /// 角色擁有的權限
  rolePermissions RolePermission[]

  @@map("role")
}

/// 系統權限
/// 定義後端 API 可執行的操作權限
model Permission {
  /// 權限 ID
  id Int @id @default(autoincrement())

  /// 功能代碼
  featureCode Int @map("feature_code")

  /// 權限名稱
  name String @unique

  /// API 路徑 (例如: "/api/users")
  apiPath String @map("api_path")

  /// API 操作類型 （0: GET, 1: POST, 2: PUT, 3: DELETE）
  actionType Int @map("action_type")

  /// 權限是否啟用
  isActive Boolean @default(true) @map("is_active")

  /// 是否需要登入及權限驗證
  isRequired Boolean @default(true) @map("is_required")

  /// 權限說明
  description String?

  /// 建立時間
  createdAt DateTime @default(now()) @map("create_time")

  /// 更新時間
  updatedAt DateTime @updatedAt @map("update_time")

  /// 使用此權限的角色
  rolePermissions RolePermission[]

  /// 同一個 API 路徑與操作類型不可重複
  @@unique([apiPath, actionType])
  /// 建立功能代碼索引查詢
  @@index([featureCode])
  @@map("permission")
}

// ==========================================
// 關聯中間表 (Join Tables)
// ==========================================

/// 角色與權限關聯
model RolePermission {
  /// 角色 ID
  roleId String @map("role_id") @db.UniqueIdentifier

  /// 權限 ID
  permissionId Int @map("permission_id")

  /// 角色
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  /// 權限
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  /// roleId + permissionId 作為複合主鍵
  @@id([roleId, permissionId])
  
  @@map("role_permission")
}
