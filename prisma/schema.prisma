/// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

// ==========================================
// 核心系統
// ==========================================

/// 系統使用者
/// 用途：管理使用者帳號與登入資訊
model User {
  /// 使用者 ID
  id String @id @default(dbgenerated("newid()")) @db.UniqueIdentifier

  /// 使用者帳號
  username String @unique

  /// 使用者暱稱
  nickname String

  /// 使用者 Email
  email String @unique

  /// 使用者密碼（Bcrypt Hash）
  password String

  /// 啟用狀態
  isActive Boolean @default(true) @map("is_active")

  /// 所屬角色 ID
  roleId String? @map("role_id") @db.UniqueIdentifier

  /// 所屬角色
  role Role? @relation(fields: [roleId], references: [id])

  /// 使用者的 API 稽核日誌
  auditLogs AuditLog[]

  /// 建立時間
  createdAt DateTime @default(now()) @map("create_time")

  /// 更新時間
  updatedAt DateTime @updatedAt @map("update_time")

  @@map("user")
}

/// 系統角色
/// 用途：管理系統角色
model Role {
  /// 角色 ID
  id String @id @default(dbgenerated("newid()")) @db.UniqueIdentifier

  /// 角色名稱
  name String @unique

  /// 角色說明
  description String?

  /// 啟用狀態
  isActive Boolean @default(true) @map("is_active")

  /// 建立時間
  createdAt DateTime @default(now()) @map("create_time")

  /// 更新時間
  updatedAt DateTime @updatedAt @map("update_time")

  /// 使用此角色的使用者
  users User[]

  /// 角色擁有的頁面權限
  rolePages RolePage[]

  @@map("role")
}

/// 頁面
/// 用途：管理系統頁面
model Page {
  /// 固定頁面 ID
  id Int @id @default(autoincrement())

  /// 可修改的唯一頁面代碼
  pageCode Int @unique @map("page_code")

  /// 頁面名稱
  name String

  /// 頁面描述
  description String?

  /// 頁面路徑
  routePath String? @map("route_path")

  /// 啟用狀態
  isActive Boolean @default(true) @map("is_active")

  /// 建立時間
  createdAt DateTime @default(now()) @map("create_time")

  /// 更新時間
  updatedAt DateTime @updatedAt @map("update_time")

  /// 使用此頁面的角色
  rolePages RolePage[]
  permissions Permission[]

  @@map("page")
}

/// 系統權限
/// 用途：管理 API 存取權限
model Permission {
  /// 權限 ID
  id Int @id @default(autoincrement())

  /// 頁面 ID
  /// null 代表不屬於頁面的系統 API
  pageId Int? @map("page_id")
  page Page? @relation(fields: [pageId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  /// 權限名稱
  name String @unique

  /// API 路徑 (例如: "/api/users")
  apiPath String @map("api_path")

  /// API 操作類型 （0: GET, 1: POST, 2: PUT, 3: DELETE）
  actionType Int @map("action_type")

  /// 啟用狀態
  isActive Boolean @default(true) @map("is_active")

  /// 是否需要登入及權限驗證
  isRequired Boolean @default(true) @map("is_required")

  /// 權限說明
  description String?

  /// 建立時間
  createdAt DateTime @default(now()) @map("create_time")

  /// 更新時間
  updatedAt DateTime @updatedAt @map("update_time")

  /// 同一個 API 路徑與操作類型不可重複
  @@unique([apiPath, actionType])
  /// 建立頁面 ID 索引查詢
  @@index([pageId])
  @@map("permission")
}

// ==========================================
// 關聯資料
// ==========================================

/// 角色頁面權限
/// 用途：管理角色對頁面的存取層級
model RolePage {
  /// 角色 ID
  roleId String @map("role_id") @db.UniqueIdentifier

  /// 頁面 ID
  pageId Int @map("page_id")

  /// 存取層級
  /// VIEW：檢視
  /// EDIT：編輯
  /// 無資料代表 NONE
  accessLevel String @map("access_level")

  /// 角色
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  /// 頁面
  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  /// 同一角色與頁面只能有一筆設定
  @@id([roleId, pageId])
  @@map("role_page")
}

// ==========================================
// 系統日誌
// 用途: API 稽核日誌
// ==========================================

model AuditLog {
  /// 稽核日誌 ID
  id BigInt @id @default(autoincrement())

  /// 操作使用者 ID
  /// 未登入的 API 可為 null
  userId String? @map("user_id") @db.UniqueIdentifier

  /// API 操作
  /// 例如：GET /api/roles
  action String @db.VarChar(200)

  /// Request IP
  ipAddress String? @map("ip_address") @db.VarChar(45)

  /// User Agent
  userAgent String? @map("user_agent") @db.NVarChar(Max)

  /// HTTP Status Code
  statusCode Int @map("status_code")

  /// 系統 Business Code
  bizCode Int @default(0) @map("biz_code")

  /// Request 資料
  reqData String? @map("req_data") @db.NVarChar(Max)

  /// Response 資料
  resData String? @map("res_data") @db.NVarChar(Max)

  /// API 執行時間（毫秒）
  duration Int @default(0)

  /// API 是否執行成功
  isSuccess Boolean @default(true) @map("is_success")

  /// 建立時間
  createdAt DateTime @default(now()) @map("create_time")

  /// 操作使用者
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
  @@index([statusCode])
  @@map("audit_log")
}

// ==========================================
// 基礎資料
// ==========================================

/// 招呼站主檔
/// 用途：管理招呼站基本資料
model Stop {
  /// 招呼站 ID
  id Int @id @default(autoincrement()) @map("stop_id")

  /// 票機招呼站代碼
  bvStopCode String @map("bv_stop_code") @db.NVarChar(10)

  /// 業者招呼站代碼
  opStopCode String @map("op_stop_code") @db.NVarChar(10)

  /// 招呼站全名
  fullName String @map("stop_full_name") @db.NVarChar(50)

  /// 招呼站名稱
  name String @map("stop_name") @db.NVarChar(50)

  /// 緯度 1
  gpsX String @map("gps1_x") @db.NVarChar(10)

  /// 經度 1
  gpsY String @map("gps1_y") @db.NVarChar(10)

  /// 緯度 2
  gps2X String @map("gps2_x") @db.NVarChar(10)

  /// 經度 2
  gps2Y String @map("gps2_y") @db.NVarChar(10)

  /// GPS 備註
  gpsMemo String @map("gps_memo") @db.NVarChar(255)

  /// 免費公車區碼
  freeBusAreaCode String @map("free_bus_area_code") @db.NVarChar(20)

  /// 啟用狀態
  isActive Boolean @default(true) @map("is_active")

  /// 更新時間
  updatedAt DateTime @updatedAt @map("update_time")

  /// 更新者 ID
  updateUserId String @map("update_user_id") @db.UniqueIdentifier

  @@map("sys_stop")
}
